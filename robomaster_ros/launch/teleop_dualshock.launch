<launch>

  <arg name="name" default=""/>
  <arg name="publish_rate_hz" default="20.0"/>
  <arg name="joy_timeout_sec" default="0.25"/>
  <arg name="deadzone" default="0.1"/>
  <arg name="linear_x_scale" default="-1.5"/>
  <arg name="linear_y_scale" default="-1.5"/>
  <arg name="gimbal_yaw_speed_deg_s" default="-360.0"/>
  <arg name="gimbal_pitch_speed_deg_s" default="-180.0"/>
  <arg name="max_gimbal_yaw_deg" default="200.0"/>
  <arg name="god_mode_yaw_speed_deg_s" default="400.0"/>
  <arg name="follow_gimbal_yaw_kp" default="4.0"/>
  <arg name="blaster_hz" default="8.0"/>
  <arg name="blaster_sound_id" default="15"/>

  <push-ros-namespace namespace="$(var name)"/>

  <node name="joy" pkg="joy" exec="joy_node" output="screen" args="--ros-args --log-level info">
    <param name="autorepeat_rate" value="$(var publish_rate_hz)" />
  </node>

  <node name="robomaster_teleop" pkg="robomaster_ros" exec="robomaster_teleop"
        output="screen" args="--ros-args --log-level info">
    <param name="publish_rate_hz" value="$(var publish_rate_hz)" />
    <param name="joy_timeout_sec" value="$(var joy_timeout_sec)" />
    <param name="deadzone" value="$(var deadzone)" />
    <param name="linear_x_scale" value="$(var linear_x_scale)" />
    <param name="linear_y_scale" value="$(var linear_y_scale)" />
    <param name="gimbal_yaw_speed_deg_s" value="$(var gimbal_yaw_speed_deg_s)" />
    <param name="gimbal_pitch_speed_deg_s" value="$(var gimbal_pitch_speed_deg_s)" />
    <param name="max_gimbal_yaw_deg" value="$(var max_gimbal_yaw_deg)" />
    <param name="god_mode_yaw_speed_deg_s" value="$(var god_mode_yaw_speed_deg_s)" />
    <param name="follow_gimbal_yaw_kp" value="$(var follow_gimbal_yaw_kp)" />
    <param name="blaster_hz" value="$(var blaster_hz)" />
    <param name="blaster_sound_id" value="$(var blaster_sound_id)" />
  </node>

</launch>
